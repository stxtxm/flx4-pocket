<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLX4 POCKET"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />

            <io.github.timotheegrollier.flx4pocket.VuView
                android:id="@+id/master_vu"
                android:layout_width="72dp"
                android:layout_height="5dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Master level" />

            <TextView
                android:id="@+id/btn_library"
                style="@style/Btn.Wrap"
                android:text="LIBRARY" />

            <TextView
                android:id="@+id/btn_audio"
                style="@style/Btn.Wrap"
                android:text="AUDIO" />

            <TextView
                android:id="@+id/btn_update"
                style="@style/Btn.Wrap" />
        </LinearLayout>

        <!-- Scrolling waveforms, stacked so the beats of both decks line up -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:orientation="vertical">

            <include
                android:id="@+id/wave_a"
                layout="@layout/view_wave" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/bg" />

            <include
                android:id="@+id/wave_b"
                layout="@layout/view_wave" />
        </LinearLayout>

        <!-- Deck A | mixer | Deck B; the library opens over this part only, so
             both waveforms and their remaining time stay in sight while browsing. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="2dp">

            <io.github.timotheegrollier.flx4pocket.DeckPanel
                android:id="@+id/deck_a"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/channel_a"
                        layout="@layout/view_channel" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/channel_b"
                            layout="@layout/view_channel" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mixer_smart_cfx"
                        style="@style/Btn.Wrap"
                        android:text="CFX" />

                    <io.github.timotheegrollier.flx4pocket.FaderView
                        android:id="@+id/mixer_crossfader"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="Crossfader" />

                    <TextView
                        android:id="@+id/mixer_master_cue"
                        style="@style/Btn.Wrap"
                        android:text="M.CUE" />
                </LinearLayout>

                <!-- Beat FX -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/fx_select"
                        style="@style/Btn"
                        android:layout_weight="1.5" />

                    <TextView
                        android:id="@+id/fx_beat_down"
                        style="@style/Btn"
                        android:layout_weight="0.6"
                        android:contentDescription="Shorter effect time"
                        android:text="◄" />

                    <TextView
                        android:id="@+id/fx_beats"
                        android:layout_width="34dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fx_beat_up"
                        style="@style/Btn"
                        android:layout_weight="0.6"
                        android:contentDescription="Longer effect time"
                        android:text="►" />

                    <TextView
                        android:id="@+id/fx_target"
                        style="@style/Btn"
                        android:layout_weight="0.9" />

                    <io.github.timotheegrollier.flx4pocket.FaderView
                        android:id="@+id/fx_depth"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.6"
                        android:contentDescription="Effect depth" />

                    <TextView
                        android:id="@+id/fx_on"
                        style="@style/Btn"
                        android:text="FX ON" />
                </LinearLayout>
            </LinearLayout>

            <io.github.timotheegrollier.flx4pocket.DeckPanel
                android:id="@+id/deck_b"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

    <!-- Library -->
    <LinearLayout
        android:id="@+id/library_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Shown when the library was opened from a deck: a tap on a track loads it there. -->
            <TextView
                android:id="@+id/library_target"
                style="@style/Btn.Wrap"
                android:visibility="gone" />

            <EditText
                android:id="@+id/library_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search tracks"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/library_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/library_folder"
                style="@style/Btn.Wrap"
                android:text="FOLDER" />

            <TextView
                android:id="@+id/library_close"
                style="@style/Btn.Wrap"
                android:text="CLOSE" />
        </LinearLayout>

        <ListView
            android:id="@+id/library_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/line"
            android:dividerHeight="1dp" />
    </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
