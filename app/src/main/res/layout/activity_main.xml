<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Scrolling waveforms, stacked so the beats of both decks line up. They
             own the top of the screen and grow when the panels below fold away. -->
        <LinearLayout
            android:id="@+id/waves"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <include
                android:id="@+id/wave_a"
                layout="@layout/view_wave" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/bg" />

            <include
                android:id="@+id/wave_b"
                layout="@layout/view_wave" />
        </LinearLayout>

        <!-- Panel toggles in the order of the panels below, then the app controls.
             Dragged up or down outside its buttons, it resizes the waveforms. -->
        <LinearLayout
            android:id="@+id/control_bar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/toggle_deck_a"
                style="@style/Btn.Wrap"
                android:contentDescription="Deck A controls"
                android:text="DECK A" />

            <TextView
                android:id="@+id/toggle_mixer"
                style="@style/Btn.Wrap"
                android:contentDescription="Mixer controls"
                android:text="MIXER" />

            <TextView
                android:id="@+id/toggle_deck_b"
                style="@style/Btn.Wrap"
                android:contentDescription="Deck B controls"
                android:text="DECK B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="Drag up or down to resize the waveforms"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="2dp"
                android:text="⇕"
                android:textColor="@color/text_dim"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />

            <io.github.timotheegrollier.flx4pocket.VuView
                android:id="@+id/master_vu"
                android:layout_width="64dp"
                android:layout_height="5dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Master level" />

            <TextView
                android:id="@+id/btn_library"
                style="@style/Btn.Wrap"
                android:text="LIBRARY" />

            <TextView
                android:id="@+id/btn_audio"
                style="@style/Btn.Wrap"
                android:text="AUDIO" />

            <TextView
                android:id="@+id/btn_update"
                style="@style/Btn.Wrap" />
        </LinearLayout>

        <!-- Deck A | mixer | Deck B, each folding away from its toggle above; the
             library opens over this part only, so the waveforms stay in sight. Gone
             when every panel is folded and the library closed. -->
        <FrameLayout
            android:id="@+id/panels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="2dp">

            <io.github.timotheegrollier.flx4pocket.DeckPanel
                android:id="@+id/deck_a"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/mixer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/channel_a"
                        layout="@layout/view_channel" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/channel_b"
                            layout="@layout/view_channel" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mixer_smart_cfx"
                        style="@style/Btn.Wrap"
                        android:text="CFX" />

                    <io.github.timotheegrollier.flx4pocket.FaderView
                        android:id="@+id/mixer_crossfader"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="Crossfader" />

                    <TextView
                        android:id="@+id/mixer_master_cue"
                        style="@style/Btn.Wrap"
                        android:text="M.CUE" />
                </LinearLayout>

                <!-- Beat FX -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/fx_select"
                        style="@style/Btn"
                        android:layout_weight="1.5" />

                    <TextView
                        android:id="@+id/fx_beat_down"
                        style="@style/Btn"
                        android:layout_weight="0.6"
                        android:contentDescription="Shorter effect time"
                        android:text="◄" />

                    <TextView
                        android:id="@+id/fx_beats"
                        android:layout_width="34dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fx_beat_up"
                        style="@style/Btn"
                        android:layout_weight="0.6"
                        android:contentDescription="Longer effect time"
                        android:text="►" />

                    <TextView
                        android:id="@+id/fx_target"
                        style="@style/Btn"
                        android:layout_weight="0.9" />

                    <io.github.timotheegrollier.flx4pocket.FaderView
                        android:id="@+id/fx_depth"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.6"
                        android:contentDescription="Effect depth" />

                    <TextView
                        android:id="@+id/fx_on"
                        style="@style/Btn"
                        android:text="FX ON" />
                </LinearLayout>
            </LinearLayout>

            <io.github.timotheegrollier.flx4pocket.DeckPanel
                android:id="@+id/deck_b"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

    <!-- Library -->
    <LinearLayout
        android:id="@+id/library_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Shown when the library was opened from a deck: a tap on a track loads it there. -->
            <TextView
                android:id="@+id/library_target"
                style="@style/Btn.Wrap"
                android:visibility="gone" />

            <EditText
                android:id="@+id/library_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search tracks"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/library_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/library_sort"
                style="@style/Btn.Wrap"
                android:contentDescription="Sort the tracks by BPM"
                android:text="BPM ↑" />

            <TextView
                android:id="@+id/library_playlist"
                style="@style/Btn.Wrap"
                android:contentDescription="New playlist"
                android:text="+ PLAYLIST" />

            <TextView
                android:id="@+id/library_folder"
                style="@style/Btn.Wrap"
                android:contentDescription="Add a music folder"
                android:text="+ FOLDER" />

            <TextView
                android:id="@+id/library_files"
                style="@style/Btn.Wrap"
                android:contentDescription="Add tracks"
                android:text="+ TRACKS" />

            <TextView
                android:id="@+id/library_close"
                style="@style/Btn.Wrap"
                android:text="CLOSE" />
        </LinearLayout>

        <!-- Folders (BROWSE press moves between the two lists, as in rekordbox) | tracks. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ListView
                android:id="@+id/library_folders"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:divider="@null" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/line" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.4">

                <ListView
                    android:id="@+id/library_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/line"
                    android:dividerHeight="1dp" />

                <TextView
                    android:id="@+id/library_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Add your music: + FOLDER takes a whole folder and its subfolders, + TRACKS single files. Long-press a track to put it in a playlist, a folder or playlist to remove it."
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
