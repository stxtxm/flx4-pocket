<?xml version="1.0" encoding="utf-8"?>
<!-- Touch surface of one deck: overview, pad modes, pads, loop and transport
     on the left, the tempo fader on the right. Inflated into DeckPanel. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <io.github.timotheegrollier.flx4pocket.OverviewView
            android:id="@+id/deck_overview"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_margin="2dp"
            android:contentDescription="Track overview" />

        <!-- Two-line labels (HOT / CUE): the hardware names fit however narrow the panel is. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/deck_tab_0"
                style="@style/Btn.Tab" />
            <TextView
                android:id="@+id/deck_tab_1"
                style="@style/Btn.Tab" />
            <TextView
                android:id="@+id/deck_tab_2"
                style="@style/Btn.Tab" />
            <TextView
                android:id="@+id/deck_tab_3"
                style="@style/Btn.Tab" />
            <TextView
                android:id="@+id/deck_tab_4"
                style="@style/Btn.Tab" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/deck_pad_0"
                style="@style/Btn.Big" />
            <TextView
                android:id="@+id/deck_pad_1"
                style="@style/Btn.Big" />
            <TextView
                android:id="@+id/deck_pad_2"
                style="@style/Btn.Big" />
            <TextView
                android:id="@+id/deck_pad_3"
                style="@style/Btn.Big" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/deck_pad_4"
                style="@style/Btn.Big" />
            <TextView
                android:id="@+id/deck_pad_5"
                style="@style/Btn.Big" />
            <TextView
                android:id="@+id/deck_pad_6"
                style="@style/Btn.Big" />
            <TextView
                android:id="@+id/deck_pad_7"
                style="@style/Btn.Big" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/deck_loop_in"
                style="@style/Btn.Tab"
                android:text="IN" />
            <TextView
                android:id="@+id/deck_loop_out"
                style="@style/Btn.Tab"
                android:text="OUT" />
            <!-- Shows the loop length in beats: 4 BEAT when idle, the size and EXIT during a loop. -->
            <TextView
                android:id="@+id/deck_reloop"
                style="@style/Btn.Tab"
                android:layout_weight="1.2"
                android:contentDescription="4-beat loop, or exit the loop" />
            <TextView
                android:id="@+id/deck_loop_half"
                style="@style/Btn.Tab"
                android:text="½" />
            <TextView
                android:id="@+id/deck_loop_double"
                style="@style/Btn.Tab"
                android:text="2×" />
            <TextView
                android:id="@+id/deck_quantize"
                style="@style/Btn.Tab"
                android:layout_weight="0.8"
                android:text="Q" />
            <TextView
                android:id="@+id/deck_tap"
                style="@style/Btn.Tab"
                android:text="TAP" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/deck_bend_minus"
                style="@style/Btn.Big"
                android:layout_weight="0.6"
                android:contentDescription="Pitch bend slower"
                android:text="◄" />
            <TextView
                android:id="@+id/deck_bend_plus"
                style="@style/Btn.Big"
                android:layout_weight="0.6"
                android:contentDescription="Pitch bend faster"
                android:text="►" />
            <TextView
                android:id="@+id/deck_cue"
                style="@style/Btn.Big"
                android:text="CUE"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/deck_play"
                style="@style/Btn.Big"
                android:layout_weight="1.4"
                android:textSize="22sp"
                android:contentDescription="Play / pause"
                android:text="▶" />
            <TextView
                android:id="@+id/deck_sync"
                style="@style/Btn.Big"
                android:text="SYNC"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/deck_range"
            style="@style/Btn.Tab"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_weight="0" />

        <io.github.timotheegrollier.flx4pocket.FaderView
            android:id="@+id/deck_tempo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="Tempo" />

        <!-- An arrow here: move the FLX4 tempo fader that way until it takes over. -->
        <TextView
            android:id="@+id/deck_pitch"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/deck_key"
            style="@style/Btn.Tab"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_weight="0"
            android:contentDescription="Keylock: the tempo changes, not the pitch"
            android:text="KEY" />
    </LinearLayout>
</merge>
