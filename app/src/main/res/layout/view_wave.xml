<?xml version="1.0" encoding="utf-8"?>
<!-- One deck's scrolling waveform; its track information sits on it without a
     band, so nothing hides the waveform (the text shadow keeps it readable). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@color/panel">

    <io.github.timotheegrollier.flx4pocket.WaveformView
        android:id="@+id/wave"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="3dp"
        android:paddingEnd="4dp">

        <!-- The deck letter and its tempo, one solid block in the deck's colour:
             both decks' tempos sit under each other, where the eye compares them. -->
        <LinearLayout
            android:id="@+id/wave_chip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/btn"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/wave_deck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Tabular digits: the two tempos line up digit for digit. -->
            <TextView
                android:id="@+id/wave_bpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/on_accent"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/wave_title"
            style="@style/WaveText"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end" />

        <!-- No padding: with nothing to say, its dark backing has no width. -->
        <TextView
            android:id="@+id/wave_state"
            style="@style/WaveText"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn"
            android:backgroundTint="#CC0B0E13"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/wave_time"
            style="@style/WaveText"
            android:background="@drawable/btn"
            android:backgroundTint="#CC0B0E13"
            android:fontFamily="monospace"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
