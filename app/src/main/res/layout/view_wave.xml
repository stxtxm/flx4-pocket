<?xml version="1.0" encoding="utf-8"?>
<!-- One deck's scrolling waveform; its track information sits on it without a
     band, so nothing hides the waveform (the text shadow keeps it readable). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@color/panel">

    <io.github.timotheegrollier.flx4pocket.WaveformView
        android:id="@+id/wave"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/wave_deck"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/btn"
            android:gravity="center"
            android:textColor="@color/on_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wave_title"
            style="@style/WaveText"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/wave_state"
            style="@style/WaveText"
            android:layout_marginEnd="10dp"
            android:textColor="@color/text_dim"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/wave_bpm"
            style="@style/WaveText"
            android:layout_marginEnd="10dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/wave_time"
            style="@style/WaveText"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
